# Reemplaza con tu URI real de MongoDB Atlas (Connect → Drivers → Node.js)
# NO uses este valor de ejemplo; el servidor no arrancará con él.
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster0.xxxxx.mongodb.net/mare?retryWrites=true&w=majority
JWT_SECRET=tu_clave_secreta_larga_y_aleatoria_minimo_32_caracteres
PORT=5000
NODE_ENV=development
# Una o varias URLs separadas por coma (producción + previews de Vercel)
FRONTEND_URL=http://localhost:5173
# Producción: FRONTEND_URL=https://mare.vercel.app,https://mare-git-main-tu-usuario.vercel.app

# --- Correo de notificaciones: formulario de Contáctanos y nuevas reservaciones (opcional) ---
# Si no configuras estas variables, los mensajes y reservaciones igual se
# guardan en la base de datos y se ven en el panel admin, pero no se
# enviará ningún correo.
# Con Gmail: usa una "Contraseña de aplicación" (no tu contraseña normal),
# se genera en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicación
# A dónde llegan los mensajes de contacto y las notificaciones de reservación
CONTACT_EMAIL=mare.eventos.pro@gmail.com
